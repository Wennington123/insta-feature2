# Instagram API with Instagram Login (graph.instagram.com)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Opcional: host publico das midias (R2, S3, CDN). Se vazio, usa GitHub raw.
IG_MEDIA_BASE_URL=

# Opcional
IG_API_VERSION=v26.0
IG_MACHINE=

# Zernio (publicacao sem app Meta). Crie a chave em https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=
# Preenchido por `ig zernio connect --write`
ZERNIO_ACCOUNT_ID=
ZERNIO_PROFILE_ID=

# meta | zernio
PUBLISH_PROVIDER=meta
